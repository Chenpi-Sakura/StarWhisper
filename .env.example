# StarWhisper 服务端运行时配置
#
# 复制为仓库根目录的 .env 后按需修改。所有密钥仅存服务端，绝不入 git。
# 已存在的系统环境变量优先，不会被 .env 覆盖（便于部署时由密钥管理直接注入）。
#
# 未列出的变量一律走 config.py 里的默认值，可留空。

# ---------- 上游解算服务 ----------

# astrometry.net 私有化服务地址（solver 本体）
ASTROMETRY_SERVICE_URL=http://117.72.38.57:8010

# 单次上游解算超时（秒）。注意它是 httpx 的单请求超时：解算为 CPU 密集，
# 视场越窄索引搜索越细、耗时越长（实测 5–22s）。调小会误杀合法请求。
ASTROMETRY_TIMEOUT=60

# 离线演示开关：=1 时走 fixture，不打真实上游。
# 仅建议在无网络 / 上游不可用时临时开启，正式演示请保持 0。
ASTROMETRY_MOCK=0

# ---------- 跨域 ----------

# 允许的前端来源，逗号分隔。默认只放行本机 dev server。
# ⚠️ 部署到真实域名后必须把线上前端地址加进来，否则浏览器会直接拦截响应。
# 例：CORS_ORIGINS=http://localhost:5173,https://your-domain.com
CORS_ORIGINS=http://localhost:5173

# ---------- AI 故事 provider ----------

# 两条 AI 通道，make_provider() 按顺序取第一个可用的：
#   1) AgentArts（AGENTARTS_API_KEY + AGENTARTS_BASE_URL + AGENTARTS_RUNTIME_NAME 三项全非空）
#   2) OpenAI 兼容直连（AI_API_KEY 非空）
#   3) DisabledProvider —— 故事降级为 traditions 星表内嵌的预设文案

# OpenAI 兼容通道（DeepSeek 缺省）
AI_API_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 留空 = 禁用 OpenAI 通道
AI_API_KEY=

# story prompt 里按星等取最亮 N 颗星（轩辕一宿 70 颗全塞会明显膨胀 token）。<=0 = 不截断
STORY_PROMPT_MAX_STARS=12

# ---------- AgentArts 智能体运行时（华为云） ----------

# API Key 由华为云「智能体身份认证服务·工作负载身份」签发
AGENTARTS_API_KEY=
# 智能体标识（当前代码未读取，留作调用侧追踪/调试记录用）
AGENTARTS_AGENT_ID=
# 运行时名称（agent-arts- 开头）
AGENTARTS_RUNTIME_NAME=
# 区域 endpoint（不含 /runtimes 前缀）
AGENTARTS_BASE_URL=https://defaultgw-mfstsolcgz.cn-southwest-2.huaweicloud-agentarts.com
# AgentArts 调用只有 inputs.query 一个入参，没有 system 角色位。
# =1 时后端把 system prompt 拼进 query（平台侧未配人设时需要）；
# =0 表示人设已在平台侧配好，后端只发 user prompt。
AGENTARTS_SYSTEM_IN_QUERY=1

# ---------- 故事接口稳定性 ----------

# 端到端总时长预算（秒）。与 provider 层的单 chunk 读超时不同：
# 上游持续推心跳时单 chunk 超时不会触发，这里是硬预算，超时即熔断到预设文案。
STORY_TOTAL_TIMEOUT=45

# AI 故障熔断：连续失败 N 次后进入冷却，冷却期内直接返预设，不再让请求干等满超时
STORY_CB_THRESHOLD=3
STORY_CB_COOLDOWN=60

# 按客户端 IP 的固定窗口限流，超限返 429 RATE_LIMITED。<=0 = 不限流
STORY_RATE_LIMIT=60
STORY_RATE_WINDOW=60

# ---------- 观星指数（Open-Meteo，免费免 key）----------

OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT=10

# ---------- 图片生成（MiniMax 文生图）----------

# POST {IMAGE_GEN_API_BASE}/v1/image_generation，Bearer 鉴权。
# 国内站 api.minimax.cn / 国际站 api.minimax.io 的 key 互不通用（用 .io 打 .cn 的 key
# 会返 base_resp.status_code=2049 invalid api key）。
IMAGE_GEN_API_BASE=https://api.minimax.cn
# image-01：可用 width/height（[512,2048] 且 8 的倍数）与 21:9；
# image-01-live：可用 style 画风（漫画/元气/中世纪/水彩），但只吃 aspect_ratio。
IMAGE_GEN_MODEL=image-01
# 出图尺寸：width+height 都非 0 就发显式尺寸，否则退回 IMAGE_GEN_ASPECT 预设。
# 实测 aspect_ratio=16:9 只给 1280x720（铺满整页当底纹会发糊），而显式
# 1920x1080 的 n=4 是 34–37s，与旧的 1024x1024（~33s）持平，像素却翻倍。
IMAGE_GEN_WIDTH=1920
IMAGE_GEN_HEIGHT=1080
IMAGE_GEN_ASPECT=16:9
# 留空 = 未启用图片生成通道。实测单次生成 15–40s，超时预算需按此设置。
IMAGE_GEN_API_KEY=

# 单次上游请求超时（秒）。实测 n=4 时 33–38s。
IMAGE_GEN_TIMEOUT=90
# 每个 job 出几张候选做拒绝采样。提示词已按五臂实验定稿，但单张仍有约 1/4
# 概率冒出星座连线/伪文字——这是方差，不是措辞问题，所以多张让用户挑。
# 取值 [1,9]，¥0.025/张；实测 n 不影响耗时（n=1 与 n=4 都是 ~33s），只影响价钱。
IMAGE_GEN_N=4
# 全局并发闸门：占满后新 job 排队（不是 429），端到端由 JOB_TIMEOUT 兜底。
IMAGE_GEN_CONCURRENCY=3
# job 从提交到出图允许的总时长（秒），超时置 error 并计一次熔断失败。
IMAGE_GEN_JOB_TIMEOUT=120
# 已完成 job 在内存里的保留时长（秒）；同时也是 prompt→图片的缓存 TTL。
IMAGE_GEN_JOB_TTL=600
# 故事正文进 prompt 的字符预算。模板固定外壳约 420 字，接口硬上限 1500。
IMAGE_STORY_MAX_CHARS=900
# 离线演示开关：=1 时返回本地样张，不打真实上游、不花钱。
IMAGE_GEN_MOCK=0
