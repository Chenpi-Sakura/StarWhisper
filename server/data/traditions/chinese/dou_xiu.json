  "stories": {
    "myth": {
      "title": "斗宿：北方玄武之蛇首与南斗六星",
      "paragraphs": [
        "斗宿乃北方玄武七宿之首（斗、牛、女、虚、危、室、壁），对应玄武之首——蛇头。",
        "斗宿六星连成斗状，恰似天上之\"北斗\"，故古人有\"南斗注生、北斗注死\"之说——南斗司命，北斗主寿终。",
        "斗宿之分野对应古代吴越、扬州一带。古人祈寿时，常向南斗祈求。"
      ]
    },
    "science": {
      "title": "斗宿之位与星数",
      "paragraphs": [
        "斗宿位于赤经约 278°、赤纬约 -23°，处射手座（Sagittarius）。",
        "斗宿六星对应射手座 φ、λ、μ、σ、τ、ζ，距 200 至 300 光年不等。最佳观测月份为 7 月至 9 月。"
      ]
    }
  }
}
