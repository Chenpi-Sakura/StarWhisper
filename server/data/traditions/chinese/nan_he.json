  "stories": {
    "myth": {
      "title": "南河：天河南岸的三颗守望者",
      "paragraphs": [
        "南河三星者，天河南岸之三颗星也，与北河三星隔河相望。",
        "南河、北河共为银河两岸之象征——古人言银河自天上流下，两岸即南河、北河。",
        "南河之旁有\"天稷\"\"农丈人\"等农业相关之星官，故南河亦主管水利农事。"
      ]
    },
    "science": {
      "title": "南河：小犬座的亮星",
      "paragraphs": [
        "南河三星主要在小犬座，最亮之一颗为南河三（小犬座 α，0.4 等），乃全天第八亮星。",
        "与北河三（双子座 β）隔银河相望；每年冬末春初自东方升起。",
        "冬季夜空之东南，南河与北河隔河相望，共成天上之双子河神。"
      ]
    }
  }
}
