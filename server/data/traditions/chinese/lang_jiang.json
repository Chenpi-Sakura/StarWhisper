  "stories": {
    "myth": {
      "title": "郎将：天帝身侧之武将之首",
      "paragraphs": [
        "郎将仅一星，乃天帝身侧武将郎官之首，掌宿卫宫廷、随侍帝侧之事。",
        "其与郎位、幸臣等\"郎\"字辈星官同列，共构天帝之近卫军体系。",
        "古人眼中，天上恰似地上之朝廷，郎将即禁军之统领。"
      ]
    },
    "science": {
      "title": "郎将：太微垣北侧之一颗孤星",
      "paragraphs": [
        "郎将对应后发座附近一颗 4.93 等星（HIP 62763），位置紧邻太微垣。",
        "主星周围犹有郎将增一等几颗暗星相伴，整组跨度不大。",
        "每年春夜自东方升起，乃春季星空太微垣之成员。"
      ]
    }
  }
