  "stories": {
    "myth": {
      "title": "扶筐：织女采桑叶所挎之篮",
      "paragraphs": [
        "扶筐乃织女采桑叶时所挎之\"扶筐\"。",
        "传说天上织女嫁与牛郎，被王母娘娘以银河隔开，仅得七夕一晤。织女日常在天上纺织，亦养蚕采桑，扶筐即是装桑叶之篮。",
        "扶筐位于织女星（Vega，天琴座 α）北侧，旁有\"九坎\"\"渐台\"等水泽之星，象征织女所处之环境。"
      ]
    },
    "science": {
      "title": "扶筐之位",
      "paragraphs": [
        "扶筐位于赤经约 282°、赤纬约 +58°，处天琴座（Lyra）北侧，逼近天龙座（Draco）。",
        "八星组成筐形，主星约 4 至 5 等。"
      ]
    }
  }
}
