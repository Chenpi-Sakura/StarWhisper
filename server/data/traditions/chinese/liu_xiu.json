  "stories": {
    "myth": {
      "title": "柳宿：朱雀三宿，柳叶与厨宰",
      "paragraphs": [
        "柳宿乃南方朱雀七宿之第三宿，八星排列若下垂之柳叶枝条，古人视为柳叶之形。",
        "柳宿主厨宰之事——古人以朱雀为掌管饮食之南方神，柳下即为厨灶，故柳宿之侧有\"天稷\"\"天庙\"诸农食星官。",
        "占星书云\"柳主草木\"，柳星明亮则菜肴丰美、天下安宁。"
      ]
    },
    "science": {
      "title": "柳宿：长蛇座头部之八星",
      "paragraphs": [
        "柳宿八星主要在长蛇座头部，跨度约八度，距星柳宿一（长蛇座 δ）乃 3.8 等之橙色巨星。",
        "每年初夏至盛夏从东方升起，乃夏季星空东边之代表。",
        "柳宿附近尚有天稷、天庙诸星官，共成朱雀七宿里最热闹之一片天区。"
      ]
    }
  }
}
