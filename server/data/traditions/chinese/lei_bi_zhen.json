  "stories": {
    "myth": {
      "title": "垒壁阵：紫微垣外围之城垣",
      "paragraphs": [
        "垒壁阵十二星乃天上卫护皇宫之城垣，自北落师门一路排开，如一条长长之兵营。",
        "古人以垒壁阵比天宫之城垣，环卫紫微垣与太微垣，乃天子之外城垣。",
        "此一圈星与北落师门、羽林军共组天帝都城之多重防卫。"
      ]
    },
    "science": {
      "title": "垒壁阵：横跨赤道南北之狭长星带",
      "paragraphs": [
        "垒壁阵十二星主要在宝瓶座、双鱼座与鲸鱼座之间，乃横跨赤道南北之一片狭长星带。",
        "诸星亮度不高，多在 4 至 5 等，须待秋冬之夜方能见其完整轮廓。",
        "北落师门乃垒壁阵最南端之门楼，为此片天区最亮之一星。"
      ]
    }
  }
}
