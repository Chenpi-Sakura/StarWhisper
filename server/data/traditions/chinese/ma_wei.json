  "stories": {
    "myth": {
      "title": "马尾：天马的尾巴",
      "paragraphs": [
        "马尾三星者，天马尾巴之部分，绘于半人马座南边，象征天马之尾。",
        "其与马腹、马膝共组成完整之天马，对应半人马座之下半身。",
        "传说天马乃大宛宝马之之化身，绘于天上飞驰，护佑人间交通顺畅。"
      ]
    },
    "science": {
      "title": "马尾：半人马座南端的三星",
      "paragraphs": [
        "马尾三星位于半人马座南端，亮度四至五等之间。",
        "位置在南纬 -55° 至 -60° 之间，北方地区基本不可见。",
        "唯至岭南以南，方能在春季夜空见此匹完整之天马。"
      ]
    }
  }
}
