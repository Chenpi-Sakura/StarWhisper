  "stories": {
    "myth": {
      "title": "青丘：南方狐族所栖那片青丘",
      "paragraphs": [
        "青丘七星乃南方之青色山丘，相传为狐族所栖。古人谓南方有青丘国，乃九尾狐出没之处，故此片天区命名为青丘。",
        "《山海经》载青丘之山有狐兽、九尾。古人将此种传说搬至天上，于是青丘便成了天帝管南方异兽之小山。",
        "星占之中，青丘主蛮夷与远方之事。它明亮代表远方进贡、邦交顺畅；暗则意味边疆有异动，或朝贡不至。"
      ]
    },
    "science": {
      "title": "青丘：豺狼、半人马之间之七星",
      "paragraphs": [
        "青丘七星主要分布于豺狼座（Lupus）与半人马座（Centaurus）之间之天区，赤纬在 -40° 以南，靠近南天低空。",
        "主星青丘一即豺狼座某一颗，亮度约 4 等左右。此一带乃夏季南天银河之一段，星点密集、亮度中等。",
        "于北纬中纬度之地观之，青丘几颗星常年仅能贴着南地平线见到。它与库楼、骑官、积卒等南方军事星官共处，共成完整之\"南方天区军事带\"。"
      ]
    }
  }
}
