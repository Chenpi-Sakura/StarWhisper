  "stories": {
    "myth": {
      "title": "大理：天上专审刑狱之法官",
      "paragraphs": [
        "大理本古官名，专掌刑狱复核之事。古人将人间之大理寺搬上霄汉，特设\"大理\"二星以主刑狱。",
        "天上大理若明，则刑狱清明、狱讼公正；若暗弱，则刑狱冤滥、百姓遭殃。大理常与天理、贯索等星并列，共构天上之法度体系。"
      ]
    },
    "science": {
      "title": "大理：天龙座与小熊座之间的二暗星",
      "paragraphs": [
        "大理位于赤经约 184°、赤纬约 +76°，在天龙座与小熊座之间，紧邻北极。",
        "主星约 4 等，二星组成。"
      ]
    }
  }
