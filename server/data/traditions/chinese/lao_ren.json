  "stories": {
    "myth": {
      "title": "老人：南极仙翁之化身，全天最吉祥之星",
      "paragraphs": [
        "老人星乃南极仙翁之化身，唯天下太平、君王贤德之时始见，象征长寿与祥瑞。",
        "古代占星家以老人星为国运兴衰之预兆——星明则国泰民安，星暗则天下多故。",
        "此星官象征南极之精，地位极高，然位置偏南，北方难见。古人以为能见之者，皆盛世之征兆。"
      ]
    },
    "science": {
      "title": "老人：全天第二亮星 Canopus",
      "paragraphs": [
        "老人即船底座 α（α Car），英文名 Canopus，全天第二亮恒星，仅次于天狼星，视亮度约 -0.62 等。",
        "去日约 310 光年，乃一颗 A9 型白色超巨星，绝对星等约 -5.7 等，较太阳亮逾万倍。",
        "老人星赤纬 -52°，北纬 37° 以北地区基本不可见，岭南以南方易观测。"
      ]
    }
  }
}
