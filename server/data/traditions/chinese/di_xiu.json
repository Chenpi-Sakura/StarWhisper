  "mansion": "di_xiu",
  "asterism_id": null,
  "stories": {
    "myth": {
      "title": "氐宿：东方苍龙之胸腹与根",
      "paragraphs": [
        "氐宿乃东方苍龙七宿之第三宿（角、亢、氐、房、心、尾、箕），位居苍龙胸腹之间。",
        "\"氐\"字本义，即植物之根。古以苍龙七宿象东方七宿，氐宿应于龙之胸腹，亦即\"万物之根\"。",
        "古占之中，氐宿朗照则大地丰登，暗弱则五谷歉收。其分野大略对应古宋国与豫州一带。《史记·天官书》云：\"氐为天根，主万物。\""
      ]
    },
    "science": {
      "title": "氐宿位置与星数",
      "paragraphs": [
        "氐宿位于赤经约 228°、赤纬约 -10°，主要对应天秤座（Libra）。",
        "四星：氐宿一为天秤座 α2（Zubenelgenubi，2.75 等），氐宿二为天秤座 β（4.54 等），氐宿三为 β 之另一子星，氐宿四为天秤座 γ（3.91 等）。距地约 80 光年。最佳观测月份为 6 月至 7 月。"
      ]
    }
  }
}
