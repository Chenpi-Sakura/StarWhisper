  "stories": {
    "myth": {
      "title": "灵台：天子之国家天文台",
      "paragraphs": [
        "灵台者，天子观天象、测历法之高台也，六星排作高台之形。",
        "古人云灵台乃用以\"望云物、观灾祥\"之地，实即古代之国家天文台。",
        "灵台与太微垣内之\"明堂\"相对应——明堂议政，灵台观天，分工甚明。"
      ]
    },
    "science": {
      "title": "灵台：猎户座与大犬座间之六星",
      "paragraphs": [
        "灵台六星位于猎户座与大犬座之间，主星 4 至 5 等，肉眼可辨。",
        "此片天区对应冬季星空之东南方，每年冬末至春初最易得见。",
        "灵台紧靠天狼、军市，乃冬季星空东南方之一片代表性星官。"
      ]
    }
  }
}
