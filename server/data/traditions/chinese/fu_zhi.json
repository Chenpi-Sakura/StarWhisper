  "stories": {
    "myth": {
      "title": "𫓧锧：天上那方行刑之砧",
      "paragraphs": [
        "𫓧锧者，古代行刑之具也——\"𫓧\"为斧头，\"锧\"乃斧下之砧板。",
        "古人想象天帝亦有此刑具，与\"𫓧钺\"配合而用。𫓧锧代表刑狱之事，乃天帝法度之象征。",
        "古代\"𫓧锧\"二字常连用，专指斧与砧此种刑具。"
      ]
    },
    "science": {
      "title": "𫓧锧：鲸鱼、波江之间之行刑具",
      "paragraphs": [
        "𫓧锧位于赤经约 26°、赤纬约 -21°，在鲸鱼座（Cetus）与波江座（Eridanus）附近。",
        "几颗星组成。"
      ]
    }
  }
