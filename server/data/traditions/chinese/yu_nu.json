  "stories": {
    "myth": {
      "paragraphs": [
        "御女乃后宫里伺候天帝起居之女官——比妃嫔低一等，专掌天帝日常起居、饮食梳洗。古人以为天帝既有后宫，自然须有宫女服侍。",
        "御女乃其中位较低之一层。占星家以为御女星主后宫是否安之、女官是否尽职。御女星明则后宫井井有条，暗弱则宫中有变、妃嫔失和。"
      ],
      "title": "御女：天帝后宫里伺候起居之女官"
    },
    "science": {
      "paragraphs": [
        "御女四星位于天龙座与武仙座交界之高纬度天区，赤经约 14h41m，赤纬约 +61°。此带紧邻北斗斗柄之北方，全年可见，从不落入地平线下。",
        "星等在 4 至 6 等之间，主星御女三视星等约 3.55，乃其中较亮之一颗。御女星位于紫微垣外缘，象天帝居所之贴身服务，乃后宫天区之核心星官。"
      ],
      "title": "御女：天龙座之高纬四星"
    }
  }
}
