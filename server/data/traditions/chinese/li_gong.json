  "stories": {
    "myth": {
      "title": "离宫：天帝出巡之别院",
      "paragraphs": [
        "离宫六星，乃天帝出游时之别院——平居紫微宫，巡游时则住离宫。",
        "离宫旁犹有\"天乙\"\"太乙\"等侍从星，整组构成天子出巡之临时居所。",
        "\"离宫\"二字古义本为帝王之别院，画于天上，以象天子之巡游制度。"
      ]
    },
    "science": {
      "title": "离宫：飞马座前部之拱极星",
      "paragraphs": [
        "离宫六星主要位于飞马座前部，亮度介于 4 至 5 等，跨度不大，紧靠北极星。",
        "因近北天极，离宫为拱极星之一，全年可见。",
        "于拱极圈中，离宫常与天钩、北极五星等同为天帝御花园之属。"
      ]
    }
  }
}
