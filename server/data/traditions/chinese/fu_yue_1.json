  "stories": {
    "myth": {
      "title": "𫓧钺：天帝行刑所执之大斧",
      "paragraphs": [
        "𫓧钺者，古之兵器，亦为刑具，象征王权之威严。古人想象天帝亦执\"斧钺\"以示威武，故天上专设此大斧。",
        "𫓧钺主刑杀之事，与\"天理\"星同，皆天帝执法之具。\"斧\"者行刑之器，\"钺\"者大斧也。",
        "古占中斧钺代表王法：星明则刑罚严明，星暗则法度废弛。"
      ]
    },
    "science": {
      "title": "𫓧钺位置",
      "paragraphs": [
        "𫓧钺位于赤经约 356°、赤纬约 -18°，处鲸鱼座（Cetus）。",
        "三星组成斧形。"
      ]
    }
  }
}
