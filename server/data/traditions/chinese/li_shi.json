  "stories": {
    "myth": {
      "title": "砺石：天军磨刀的石头",
      "paragraphs": [
        "砺石者，磨刀之石也。古人将其绘于军市与天狼之旁，象征军械之打磨。",
        "此组星官提醒将士：刀剑不用时须磨砺，故置与军营相关之位置。",
        "\"刀不磨要生锈，兵不练要落后\"——砺石即天军中之磨刀石。"
      ]
    },
    "science": {
      "title": "砺石：大犬座西南的四颗暗星",
      "paragraphs": [
        "砺石四星位于大犬座西南，靠近天狼星一群，亮度皆在五等左右。",
        "位置偏南，北方只能见北边一两颗，长江以南方能完整见此四星。",
        "砺石紧挨天狼，每年冬末春初自东方升起，乃冬季大犬天区之一组小星。"
      ]
    }
  }
