  "stories": {
    "myth": {
      "title": "盖屋：天市垣中之屋盖",
      "paragraphs": [
        "盖屋乃天上之\"屋顶\"，象房屋之顶盖。古代星占中盖屋代表宫室或天帝居所之屋顶。",
        "盖屋附近常有\"天廪\"\"天囷\"等仓库之星，皆天市垣之附属星官。",
        "盖屋主\"宫室\"，乃天上屋宅之代表。"
      ]
    },
    "science": {
      "title": "盖屋之位",
      "paragraphs": [
        "盖屋位于赤经约 331°、赤纬约 -1°，处飞马座（Pegasus）与宝瓶座（Aquarius）之间。",
        "二星组成屋盖之状。"
      ]
    }
  }
