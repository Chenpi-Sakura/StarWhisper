  "stories": {
    "myth": {
      "title": "房宿：东方苍龙之胸腹与天库",
      "paragraphs": [
        "房宿乃东方苍龙七宿之第四宿（角、亢、氐、房、心、尾、箕），对应苍龙之胸腹。",
        "房宿四星排列齐整，状若四方之房，故得名\"房\"。古人以房宿为天帝之宝库——所谓\"房为天府，藏珍宝\"。",
        "古占之中，房宿明则国家昌盛，摇动则有兵乱。其分野对应古宋国与豫州一带。"
      ]
    },
    "science": {
      "title": "房宿：天蝎头胸之四颗主星",
      "paragraphs": [
        "房宿位于赤经约 238°、赤纬约 -24°，在天蝎座（Scorpius）头部。",
        "房宿四星对应天蝎座 π（房宿一，2.89 等）、ρ（房宿二，3.87 等）、δ（房宿三，2.29 等，Dschubba）、ν（房宿四，2.56 等）。最佳观测月份为 6 月至 8 月。"
      ]
    }
  }
}
