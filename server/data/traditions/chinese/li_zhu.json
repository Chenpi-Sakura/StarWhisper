  "stories": {
    "myth": {
      "title": "离珠：后妃所佩之珠串",
      "paragraphs": [
        "离珠乃后妃所佩之珠串，象母仪天下之端庄。",
        "与离瑜、离宫相邻，三者共组后妃在天上之居所与饰品。",
        "古人云后宫之德如玉如珠，离瑜为玉，离珠为珠，并称后妃之双重象征。"
      ]
    },
    "science": {
      "title": "离珠：天猫座之五颗暗星",
      "paragraphs": [
        "离珠五星位于天猫座与小狮座之间，亮度皆在 5 等左右，肉眼视之较暗。",
        "位处紫微垣北侧，乃拱极星之一部，全年可见。",
        "天猫座本身星等不高，离珠须天气晴朗时方易分辨。"
      ]
    }
  }
}
