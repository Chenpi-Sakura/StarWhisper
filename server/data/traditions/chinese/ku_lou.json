  "stories": {
    "myth": {
      "title": "库楼：天军之兵营与仓库",
      "paragraphs": [
        "库楼十星乃天军之武器库与营房。下有\"柱\"为栏杆，\"衡\"作横梁，整组画出宛若一座高高耸立之仓库。",
        "古人将军械储备、兵员调度皆归库楼所管，旁又配\"骑阵\"\"将军\"诸星官，共组完整之天界军营。",
        "库楼与天上\"天枪\"\"天棓\"同，皆拱卫天子南面之天兵。"
      ]
    },
    "science": {
      "title": "库楼：横跨半人马座之南天星官",
      "paragraphs": [
        "库楼十星位于半人马座，跨度自赤纬 -40° 一路延至 -60°，横跨小半个星座。",
        "主星多为 4 至 5 等，须至长江以南方能完整见之，北方地区仅能窥其北部一角。",
        "因位置偏南，库楼乃中国传统星官中最\"遥远\"之星官之一。"
      ]
    }
  }
}
