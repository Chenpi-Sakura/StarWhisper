  "stories": {
    "myth": {
      "title": "三公（紫微）：紫微垣中掌国运之三位宰相",
      "paragraphs": [
        "三公乃紫微垣内辅佐天帝之三位宰相，地位比太微垣三公更高。紫微垣乃天帝之寝宫，故此三公最为贴心、最为机密。",
        "三公总管国家大政，替天帝处理最核心之事务。古代星占云：三公齐明，象征国运昌盛、帝王贤明；若有一颗不见，便代表朝廷缺人，国家动荡。",
        "紫微垣三公与太微垣三公同名而位异——紫微偏私，太微偏公。此乃古人以星象区分\"宫廷内务\"与\"朝廷政事\"之精细设计。"
      ]
    },
    "science": {
      "title": "三公（紫微）：天龙座中段之二暗星",
      "paragraphs": [
        "三公二星位于紫微垣内、对应天龙座（Draco）中段之天区，临近天乙、太乙等星官。星等约 4.7–5.1 等，亮度偏低。",
        "此片天区处北天高纬度，整年绕极旋转。自北斗勺口往北极方向延伸即可寻得。位置紧邻紫微垣主体，故古代星占家极为关注。",
        "紫微垣三公于星图上属于内朝核心，象征天帝最贴身之智囊团。古人将\"宫廷机要\"与\"朝堂议政\"区分开来，正乃中国星官系统严密细分之体现。"
      ]
    }
  }
}
