  "stories": {
    "myth": {
      "title": "离瑜：王妃胸前那枚美玉",
      "paragraphs": [
        "离瑜者，王妃所佩之玉饰也——\"瑜\"本即美玉之义，离王后佩之以示端庄。",
        "此组星官代表后妃品德之美，与离宫共拱北极。",
        "\"瑕不掩瑜，瑜不掩瑕\"——古人以玉喻德，离瑜即王后美德之象征。"
      ]
    },
    "science": {
      "title": "离瑜：天龙座头部之五颗拱极星",
      "paragraphs": [
        "离瑜五星位于天龙座头部附近，亮度皆在四至五等之间。",
        "因靠近北天极，离瑜乃拱极星之一，全年皆能从北方天空见其缓缓转圈。",
        "此片天区在恒显圈以北，中国北方观测条件最佳。"
      ]
    }
  }
}
