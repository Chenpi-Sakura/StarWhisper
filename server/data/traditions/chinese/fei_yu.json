  "stories": {
    "myth": {
      "title": "飞鱼：南方天区之飞鱼",
      "paragraphs": [
        "飞鱼乃中国古代近南极星官之一，象征南海中之飞鱼，属\"恒隐圈\"外之星官。",
        "中国古代中原地区难见此片星区，故近南极星官在古天文中少被人注目。",
        "飞鱼属近南极星官，与蛇、孔雀、海山等共组南方天区之水族群。"
      ]
    },
    "science": {
      "title": "飞鱼之位",
      "paragraphs": [
        "飞鱼位于赤经约 120°、赤纬约 -69°，处飞鱼座（Volans）与绘架座（Pictor）附近。",
        "几颗 5 至 6 等星组成鱼形。"
      ]
    }
  }
}
